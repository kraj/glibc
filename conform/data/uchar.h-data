#if defined ISO11 || defined ISO23 || defined XOPEN2K24 || defined POSIX2024
type mbstate_t
type size_t
#if defined ISO23
type char8_t
#endif
type char16_t
type char32_t

function size_t mbrtoc16 (char16_t *, const char *, size_t, mbstate_t *)
function size_t c16rtomb (char *, char16_t, mbstate_t *)
function size_t mbrtoc32 (char32_t *, const char *, size_t, mbstate_t *)
function size_t c32rtomb (char *, char32_t, mbstate_t *)

#if defined ISO23
function size_t mbrtoc8 (char8_t *, const char *, size_t, mbstate_t *)
function size_t c8rtomb (char *, char8_t, mbstate_t *)
#endif

#endif
